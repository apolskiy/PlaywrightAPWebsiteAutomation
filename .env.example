# Copy to `.env` for local runs. CI injects these as repository secrets/variables.

# Application under test.
BASE_URL=https://apolskiy.github.io/

# Ceiling for Playwright's auto-retrying assertions, in milliseconds.
EXPECT_TIMEOUT_MS=10000

# Claude AI failure diagnostics. Both variables are required to activate the
# hook; with either missing, failures still attach a screenshot and a DOM
# snapshot but no root-cause analysis.
AI_DIAGNOSTICS_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
